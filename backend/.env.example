# Production MongoDB Atlas URI (or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/trainee-hostel?retryWrites=true&w=majority

# JWT Token Secret for Session Authentication
JWT_SECRET=your_secure_random_jwt_secret_here

# Backend Port
PORT=5000

# Client Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173
