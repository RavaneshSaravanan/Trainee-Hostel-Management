# ==========================================
# Backend Environment Configuration (Render)
# ==========================================

# 1. MongoDB Connection String (Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/trainee-hostel?retryWrites=true&w=majority

# 2. JWT Secret for secure session tokens
JWT_SECRET=your_super_secret_jwt_random_string_here_change_in_production

# 3. Server Port (Render automatically injects PORT, default 5000)
PORT=5000

# 4. Node Environment
NODE_ENV=production

# 5. Allowed Frontend Origin for CORS and Email Link Generation
# Production: Set to your live Vercel frontend URL
CLIENT_ORIGIN=https://trainee-hostel-management.vercel.app

# 6. SMTP Email Settings (Gmail App Password or custom SMTP for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apollotyres.hostel@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Apollo Tyres Ltd Hostel Administration <apollotyres.hostel@gmail.com>
ADMIN_EMAIL=apollotyres.hostel@gmail.com
