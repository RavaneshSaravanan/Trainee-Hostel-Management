# ==========================================
# Backend Environment Configuration (Render)
# ==========================================

# 1. MongoDB Connection String (Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/trainee-hostel?retryWrites=true&w=majority

# 2. JWT Secret for secure session tokens
# SECURITY REQUIREMENT: In production, must be a high-entropy string of at least 32 characters.
# Never use default or predictable strings in production.
JWT_SECRET=your_super_secret_jwt_random_string_here_min_32_chars_long

# 3. Server Port (Render automatically injects PORT, default 5000)
PORT=5000

# 4. Node Environment
NODE_ENV=production

# 5. Allowed Frontend Origin for CORS and Email Link Generation
# Production: Set to your live Vercel frontend URL
CLIENT_ORIGIN=https://trainee-hostel-management.vercel.app

# Application Frontend URL for Email Links and OTP redirects
# Frontend Application URL for Decision Review Links and OTP redirects (Required)
FRONTEND_URL=https://trainee-hostel-management.vercel.app
APP_URL=https://trainee-hostel-management.vercel.app

# 6. Email Dispatch Settings (Render Free Tier Compatibility)
# ==============================================================================
# NOTE FOR RENDER FREE TIER DEPLOYMENTS:
# Render Free Web Services completely block outbound TCP connections on SMTP ports 25, 465, and 587.
# Standard Gmail SMTP will time out on Render Free.
# In production, SMTP is strictly disabled. Use Resend HTTPS API (Port 443):

# PRIMARY (Recommended - Resend HTTPS API): 3,000 free emails/month
# 1. Sign up at https://resend.com -> Create API Key
# 2. Add to Render Environment Variables:
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: customize sender (Default: Apollo Tyres Ltd <onboarding@resend.dev> or your verified domain)
RESEND_FROM=Apollo Tyres Ltd <onboarding@resend.dev>

# SECONDARY (Alternative HTTPS API - Brevo): 300 free emails/day
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# 7. Local Development Only (Ignored in production)
# Direct SMTP via Gmail App Password (only used when NODE_ENV=development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=apollotyres.hostel@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Apollo Tyres Ltd Hostel Administration <apollotyres.hostel@gmail.com>
ADMIN_EMAIL=apollotyres.hostel@gmail.com
